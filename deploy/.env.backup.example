# Root-only file: /opt/leadshelf/prod/.env.backup (chmod 600).
# Restic repository must be outside the production VPS.
RESTIC_REPOSITORY="s3:https://backup.example.invalid/leadshelf"
RESTIC_PASSWORD="replace-with-a-long-random-secret"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="eu-central-1"

# Optional operational tuning.
# Config, receipt and their immediate directories are owner/mode/symlink
# validated before shell config is sourced or receipt data is parsed.
LEADSHELF_BACKUP_RETENTION_DAYS="14"
LEADSHELF_BACKUP_KEEP_WEEKLY="8"
LEADSHELF_BACKUP_KEEP_MONTHLY="12"
LEADSHELF_BACKUP_MAX_AGE_HOURS="26"
LEADSHELF_RESTIC_CHECK_SUBSET="5%"

# Required before enabling production timers: incident webhook outside the VPS.
OPERATIONS_ALERT_WEBHOOK_URL="https://alerts.example.invalid/hooks/leadshelf"
