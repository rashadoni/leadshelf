# Keep the official PostgreSQL image/entrypoint, but rebuild its gosu helper
# on patched Go. Upstream postgres:16-alpine bundled gosu with Go 1.24.6.
FROM golang:1.26.6-alpine@sha256:af8d6740070b8906d12eae1c3e3ea0957fb63f492051ea05e354c38ef9fe88df AS gosu-builder
ARG GOSU_VERSION=1.19
ENV CGO_ENABLED=0
RUN apk add --no-cache git \
    && go install -trimpath -ldflags="-s -w" github.com/tianon/gosu@${GOSU_VERSION}

FROM postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
COPY --from=gosu-builder /go/bin/gosu /usr/local/bin/gosu
