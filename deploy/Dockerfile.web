# Прод-образ web + одноразовый migrate-target. Контекст сборки — корень репо.
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS base
RUN corepack enable
WORKDIR /app

FROM base AS builder
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/core/package.json packages/core/
COPY packages/api-contracts/package.json packages/api-contracts/
COPY packages/ui/package.json packages/ui/
COPY services/worker/package.json services/worker/
COPY services/vision/package.json services/vision/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @leadshelf/db exec prisma generate
# NEXT_PUBLIC/env не нужны на build: страницы динамические
RUN JWT_SECRET=build-only pnpm --filter @leadshelf/web build

# --- одноразовые миграции (docker compose run --rm migrate) ---
FROM builder AS migrate
WORKDIR /app/packages/db
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

# --- одноразовый demo seed (docker compose run --rm seed-demo) ---
FROM builder AS seed-demo
WORKDIR /app
CMD ["pnpm", "--filter", "@leadshelf/db", "seed:demo"]

# --- одноразовая заливка демо-медиа (docker compose run --rm media-backfill) ---
# В отличие от seed-demo в БД ничего не пишет, поэтому допустима на client prod.
# ENTRYPOINT, а не CMD: аргументы `docker compose run` дописываются к команде,
# так что `run --rm media-backfill --apply` включает запись в бакет.
FROM builder AS media-backfill
WORKDIR /app/packages/db
ENTRYPOINT ["pnpm", "exec", "tsx", "prisma/media-backfill.ts"]

# --- рантайм ---
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runner
WORKDIR /app
ENV NODE_ENV=production
# Сервер запускается напрямую через node. npm/corepack в runtime не нужны и
# только расширяют поверхность атаки (включая transitive CLI-зависимости).
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -S app \
    && adduser -S app -G app
COPY --from=builder --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=builder --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=app:app /app/apps/web/public ./apps/web/public
USER app
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]

# --- фоновые worker-задачи ---
# Объявлен после runner: --target runner не устанавливает тяжёлый ffmpeg.
# Runtime начинается с чистого образа, чтобы build-only pnpm/corepack caches из
# builder не попадали в production SBOM и не расширяли поверхность атаки.
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS worker
WORKDIR /app
ENV NODE_ENV=production
# TSX остаётся локальной runtime-зависимостью, package-manager CLI не нужен.
# /app/.data создаётся до mount, чтобы новый named volume наследовал owner.
RUN apk add --no-cache ffmpeg \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -S app \
    && adduser -S app -G app \
    && mkdir -p /app/.data \
    && chown app:app /app/.data
COPY --from=builder --chown=app:app /app /app
USER app
CMD ["node", "services/worker/node_modules/tsx/dist/cli.mjs", "services/worker/src/import-queue-runner.ts"]
