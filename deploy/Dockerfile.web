# Прод-образ web + одноразовый migrate-target. Контекст сборки — корень репо.
#
# Базовый node пришпилен по digest и равен 22.23.4-alpine. Предыдущий пин
# (22.23.2) нёс CVE-2026-111497 — critical и уже в списке эксплуатируемых;
# grype в джобе security рубил на нём сборку web-образа.
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS base
RUN corepack enable
WORKDIR /app

FROM base AS builder
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
# patches/ обязателен рядом с лок-файлом: pnpm читает patchedDependencies
# на install, и без каталога `pnpm install --frozen-lockfile` падает ещё
# до COPY . . — то есть ломается сборка прод-образа, а не тесты.
COPY patches/ patches/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/core/package.json packages/core/
COPY packages/api-contracts/package.json packages/api-contracts/
COPY packages/ui/package.json packages/ui/
COPY services/worker/package.json services/worker/
COPY services/vision/package.json services/vision/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @leadshelf/db exec prisma generate
# NEXT_PUBLIC/env не нужны на build: страницы динамические
RUN JWT_SECRET=build-only pnpm --filter @leadshelf/web build

# --- одноразовые миграции (docker compose run --rm migrate) ---
FROM builder AS migrate
WORKDIR /app/packages/db
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

# --- одноразовый demo seed (docker compose run --rm seed-demo) ---
FROM builder AS seed-demo
WORKDIR /app
CMD ["pnpm", "--filter", "@leadshelf/db", "seed:demo"]

# --- одноразовая заливка демо-медиа (docker compose run --rm media-backfill) ---
# В отличие от seed-demo в БД ничего не пишет, поэтому допустима на client prod.
# ENTRYPOINT, а не CMD: аргументы `docker compose run` дописываются к команде,
# так что `run --rm media-backfill --apply` включает запись в бакет.
FROM builder AS media-backfill
WORKDIR /app/packages/db
ENTRYPOINT ["pnpm", "exec", "tsx", "prisma/media-backfill.ts"]

# --- рантайм ---
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS runner
WORKDIR /app
ENV NODE_ENV=production
# Сервер запускается напрямую через node. npm/corepack в runtime не нужны и
# только расширяют поверхность атаки (включая transitive CLI-зависимости).
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -S app \
    && adduser -S app -G app
COPY --from=builder --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=builder --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=app:app /app/apps/web/public ./apps/web/public
USER app
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]

# FFmpeg distro packages temporarily carry unfixed HIGH CVEs. Build the
# upstream-patched source at an immutable commit and copy only the executable
# into the worker runtime. Network/device inputs are unnecessary: proof videos
# are always read from a tenant-scoped local temporary file.
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS ffmpeg-builder
ARG FFMPEG_COMMIT=f944afd04097178b7e3c0d6c7f4e524a9e8f6063
ARG FFMPEG_ARCHIVE_SHA256=8af9d494814124d2ad6eb2324f2d955e06a183242daee4d4c7e24df6d3b4ea0e
RUN apk add --no-cache build-base nasm \
    && wget -qO /tmp/ffmpeg.tar.gz "https://github.com/FFmpeg/FFmpeg/archive/${FFMPEG_COMMIT}.tar.gz" \
    && echo "${FFMPEG_ARCHIVE_SHA256}  /tmp/ffmpeg.tar.gz" | sha256sum -c - \
    && mkdir /tmp/ffmpeg-src \
    && tar -xzf /tmp/ffmpeg.tar.gz --strip-components=1 -C /tmp/ffmpeg-src \
    && cd /tmp/ffmpeg-src \
    && ./configure \
      --prefix=/opt/ffmpeg \
      --disable-doc \
      --disable-debug \
      --disable-network \
      --disable-devices \
      --disable-avdevice \
      --disable-ffplay \
      --disable-ffprobe \
      --disable-shared \
      --disable-everything \
      --enable-static \
      --enable-small \
      --enable-protocol=file,pipe \
      --enable-demuxer=mov,matroska \
      --enable-decoder=h264,hevc,mpeg4,vp8,vp9,av1,mjpeg,png \
      --enable-parser=h264,hevc,mpeg4video,vp8,vp9,av1,mjpeg \
      --enable-encoder=mjpeg \
      --enable-muxer=image2 \
      --enable-filter=scale \
      --enable-swscale \
    && make -j2 \
    && make install \
    && /opt/ffmpeg/bin/ffmpeg -version

# Прод-состав воркера: из сборочного дерева убираются devDependencies.
# Иначе в рантайм-образ уезжает vitest со своими vite и tinypool, и grype
# справедливо считает их уязвимостями прод-образа — тестовый прогонщик в
# проде не нужен. tsx и dotenv ради этого переведены в dependencies: воркер и
# vision действительно стартуют ими и читают .env.
FROM builder AS worker-deps
RUN pnpm prune --prod \
    && node -e "require.resolve('@prisma/client'); require.resolve('tsx/package.json')"

# --- фоновые worker-задачи ---
# Объявлен после runner: --target runner не устанавливает тяжёлый ffmpeg.
# Runtime начинается с чистого образа, чтобы build-only pnpm/corepack caches из
# builder не попадали в production SBOM и не расширяли поверхность атаки.
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS worker
WORKDIR /app
ENV NODE_ENV=production
# TSX остаётся локальной runtime-зависимостью, package-manager CLI не нужен.
# /app/.data создаётся до mount, чтобы новый named volume наследовал owner.
COPY --from=ffmpeg-builder /opt/ffmpeg/bin/ffmpeg /usr/local/bin/ffmpeg
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -S app \
    && adduser -S app -G app \
    && mkdir -p /app/.data \
    && chown app:app /app/.data
COPY --from=worker-deps --chown=app:app /app /app
USER app
CMD ["node", "services/worker/node_modules/tsx/dist/cli.mjs", "services/worker/src/import-queue-runner.ts"]
