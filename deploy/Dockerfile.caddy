# Caddy 2.11.7 rebuilt on patched Go. The upstream image carries curl, which
# this runtime does not need. Go поднят до 1.26.10: в 1.26.6 стандартная
# библиотека несла семь high-уязвимостей (GO-2026-6605, GO-2026-6613,
# CVE-2026-78660, CVE-2026-94439 и другие), и grype рубил на них образ.
FROM golang:1.26.10-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS builder
ARG CADDY_VERSION=v2.11.7
# Эти пины связаны: `go get` с явными версиями падает, если пин НИЖЕ того,
# что требует любой модуль в графе. Проверять по go.mod, а не на глаз:
# grpc@1.83.2 требует net>=0.58.0 и text>=0.41.0, а net@0.62.0 требует
# crypto>=0.58.0 — на этом сборка и падала, когда net подняли, а crypto нет.
# Поэтому crypto и text едут следом за net, даже когда своих advisories у них
# нет. У net причина своя: GO-2026-6610 чинится с 0.60.0, берём 0.62.0.
ARG GRPC_VERSION=v1.83.2
ARG X_CRYPTO_VERSION=v0.58.0
ARG X_NET_VERSION=v0.62.0
ARG X_TEXT_VERSION=v0.43.0
# go-jose: подделка подписи JWS (GHSA-mgcc-cww5-fp2q). В графе caddy только
# линия v4, её и пиним.
ARG GO_JOSE_VERSION=v4.1.7
ENV CGO_ENABLED=0
WORKDIR /build
RUN go mod init leadshelf/caddy-build \
    && go get github.com/caddyserver/caddy/v2/cmd/caddy@${CADDY_VERSION} \
    && go get google.golang.org/grpc@${GRPC_VERSION} \
        golang.org/x/crypto@${X_CRYPTO_VERSION} \
        golang.org/x/net@${X_NET_VERSION} \
        golang.org/x/text@${X_TEXT_VERSION} \
        github.com/go-jose/go-jose/v4@${GO_JOSE_VERSION} \
    && go build -trimpath -ldflags="-s -w" -o /go/bin/caddy \
        github.com/caddyserver/caddy/v2/cmd/caddy

FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates libcap mailcap \
    && mkdir -p /config/caddy /data/caddy /etc/caddy /srv \
    && chmod 1777 /config/caddy /data/caddy
COPY --from=builder /go/bin/caddy /usr/bin/caddy
RUN setcap cap_net_bind_service=+ep /usr/bin/caddy

# Match the official Caddy image's runtime identity and volume permissions.
# Existing Caddy volumes contain root-owned ACME account keys and certificates;
# switching to an arbitrary image-local UID makes TLS fail after an upgrade.
WORKDIR /srv
ENV XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data
EXPOSE 80 443 443/udp 2019
VOLUME ["/data", "/config"]

ENTRYPOINT ["caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
