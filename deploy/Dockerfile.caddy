# Caddy 2.11.4 rebuilt on patched Go. The upstream 2.11.4 image was built
# with Go 1.26.3 and contained curl; neither is needed by this runtime.
FROM golang:1.26.6-alpine@sha256:af8d6740070b8906d12eae1c3e3ea0957fb63f492051ea05e354c38ef9fe88df AS builder
ARG CADDY_VERSION=v2.11.4
# Эти четыре пина связаны: `go get` с явными версиями падает, если пин НИЖЕ
# того, что требует любой модуль в графе. Проверять по go.mod, а не на глаз:
# grpc@1.83.2 требует net>=0.58.0 и text>=0.41.0, crypto@0.56.0 требует
# net>=0.57.0 и text>=0.41.0, net@0.58.0 требует text>=0.41.0. Поэтому net и
# text поднимаются вместе с grpc/crypto, даже когда своих advisories у них нет.
ARG GRPC_VERSION=v1.83.2
ARG X_CRYPTO_VERSION=v0.56.0
ARG X_NET_VERSION=v0.58.0
ARG X_TEXT_VERSION=v0.41.0
ENV CGO_ENABLED=0
WORKDIR /build
RUN go mod init leadshelf/caddy-build \
    && go get github.com/caddyserver/caddy/v2/cmd/caddy@${CADDY_VERSION} \
    && go get google.golang.org/grpc@${GRPC_VERSION} \
        golang.org/x/crypto@${X_CRYPTO_VERSION} \
        golang.org/x/net@${X_NET_VERSION} \
        golang.org/x/text@${X_TEXT_VERSION} \
    && go build -trimpath -ldflags="-s -w" -o /go/bin/caddy \
        github.com/caddyserver/caddy/v2/cmd/caddy

FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates libcap mailcap \
    && mkdir -p /config/caddy /data/caddy /etc/caddy /srv \
    && chmod 1777 /config/caddy /data/caddy
COPY --from=builder /go/bin/caddy /usr/bin/caddy
RUN setcap cap_net_bind_service=+ep /usr/bin/caddy

# Match the official Caddy image's runtime identity and volume permissions.
# Existing Caddy volumes contain root-owned ACME account keys and certificates;
# switching to an arbitrary image-local UID makes TLS fail after an upgrade.
WORKDIR /srv
ENV XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data
EXPOSE 80 443 443/udp 2019
VOLUME ["/data", "/config"]

ENTRYPOINT ["caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
