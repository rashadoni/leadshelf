# Postgres из корневого docker-compose (порт 55432, см. docs/12)
DATABASE_URL="postgresql://leadshelf:leadshelf@localhost:55432/leadshelf?schema=public"
# 32+ байта случайности: openssl rand -hex 32
JWT_SECRET="change-me"
# Required in production. `demo` is allowed only in a separate non-client environment.
LEADSHELF_RUNTIME_PROFILE="client"
# Обязательное production-решение: задавать только все четыре значения вместе.
# Значения ниже — пример формата, не утверждённая клиентская policy.
AUTH_LOCKOUT_MAX_FAILURES=""
AUTH_LOCKOUT_WINDOW_SECONDS=""
AUTH_LOCKOUT_DURATION_SECONDS=""
AUTH_LOCKOUT_PEPPER=""
# CLI-only one-shot authorization; keep false in the long-lived web runtime.
AUTH_LOCKOUT_MANUAL_UNLOCK_ENABLED="false"
# MinIO из корневого docker-compose (dev); прод — свой MinIO/R2
S3_ENDPOINT="http://localhost:59000"
S3_ACCESS_KEY="leadshelf"
S3_SECRET_KEY="leadshelf-dev"
S3_BUCKET="leadshelf-media"
# Actual bucket objects/bytes inventory is paginated and cached for metrics.
S3_INVENTORY_CACHE_MS="900000"
# Per web replica. Ограничивает буферизацию multipart photo/video uploads.
LEADSHELF_MEDIA_UPLOAD_CONCURRENCY="8"
# Vision boundary (см. services/vision/.env.example) + Sentry crash reporting.
VISION_SERVICE_URL=""
VISION_MEDIA_PUBLIC_BASE_URL=""
VISION_MEDIA_SIGNING_SECRET=""
# Sentry: серверный DSN (пусто = выключено). Проект leadshelf-web.
SENTRY_DSN=""
# Separate operator-controlled gate for accepting durable products full-sync
# requests. Keep false until secret mount, worker gate and approval workflow are ready.
LEADSHELF_FULL_SYNC_REQUESTS_ENABLED="false"
