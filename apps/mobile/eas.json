{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hermescrm.xyz"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "zeytun-preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MOBILE_VARIANT": "leaddrive-field",
        "EXPO_PUBLIC_ORGANIZATION_SLUG": "zeytunpharm",
        "EXPO_PUBLIC_API_URL": "https://app.leaddrivecrm.org"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hermescrm.xyz"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
