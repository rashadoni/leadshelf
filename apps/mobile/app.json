{
  "expo": {
    "name": "LeadShelf",
    "slug": "leadshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.leadshelf.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LeadShelf to scan product barcodes and capture shelf proof photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LeadShelf to verify store visits and shelf proof photo location."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow LeadShelf to use the tilt sensor to guide level shelf photos."
        }
      ]
    ],
    "scheme": "leadshelf",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "947245d3-1267-4858-b6c1-16e4e799c5e8"
      }
    }
  }
}
