{
  "expo": {
    "name": "LeadShelf",
    "slug": "leadshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.leadshelf.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LeadShelf to scan product barcodes and capture shelf proof photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LeadDrive Field to verify visits and record your route during an active workday.",
          "locationAlwaysAndWhenInUsePermission": "Allow LeadDrive Field to record your route only while your workday is active.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow LeadShelf to use the tilt sensor to guide level shelf photos."
        }
      ]
    ],
    "scheme": "leadshelf",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "947245d3-1267-4858-b6c1-16e4e799c5e8"
      }
    }
  }
}
