# Expo инлайнит EXPO_PUBLIC_* на сборке. gitignored: реальные значения в .env.
# API-бэкенд (LeadShelf по умолчанию https://hermescrm.xyz).
EXPO_PUBLIC_API_URL=""

# Для отдельной Zeytunpharm / LeadDrive Field APK:
# EXPO_PUBLIC_MOBILE_VARIANT="leaddrive-field"
# EXPO_PUBLIC_ORGANIZATION_SLUG="zeytunpharm"
# EXPO_PUBLIC_API_URL="https://app.leaddrivecrm.org"
# Sentry crash reporting (пусто = выключено). Проект leadshelf-mobile.
# Внимание: JS-исключения ловятся и в Expo Go; нативные краши — только в
# dev-client/EAS сборке с @sentry/react-native (позже).
EXPO_PUBLIC_SENTRY_DSN=""
