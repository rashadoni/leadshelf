{
  "name": "leadshelf",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "db:validate": "pnpm --filter @leadshelf/db validate",
    "db:generate": "pnpm --filter @leadshelf/db generate",
    "db:migrate": "pnpm --filter @leadshelf/db migrate",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "typescript-eslint": "^8.24.0"
  }
}
