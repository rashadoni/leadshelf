{
  "name": "leadshelf",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "db:validate": "pnpm --filter @leadshelf/db validate",
    "db:generate": "pnpm --filter @leadshelf/db generate",
    "db:migrate": "pnpm --filter @leadshelf/db migrate",
    "analytics:capacity": "pnpm --filter @leadshelf/worker exec tsx ../../apps/web/src/server/analytics/capacity-benchmark.ts",
    "analytics:db-capacity": "pnpm --filter @leadshelf/worker exec tsx ../../apps/web/src/server/analytics/db-capacity-benchmark.ts",
    "alerts:check": "deploy/scripts/check-alert-rules.sh",
    "backup-recovery:test": "deploy/scripts/backup-recovery.test.sh",
    "release-preflight:test": "deploy/scripts/verify-release-approval.test.sh",
    "post-deploy-smoke:test": "deploy/scripts/post-deploy-smoke.test.sh",
    "production-env:test": "bash scripts/check-production-env-contract.test.sh",
    "help-video:sync": "node scripts/sync-help-video-availability.mjs",
    "help-video:check": "node scripts/sync-help-video-availability.mjs --check",
    "help-video-assets:test": "scripts/validate-help-video-assets.test.sh && node scripts/sync-help-video-availability.mjs --check",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^1.1.19",
      "compression": "^1.8.2",
      "js-yaml": "^4.3.2",
      "node-forge": "^1.4.1",
      "postcss": "^8.5.10",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2"
    }
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "playwright": "1.61.1",
    "typescript-eslint": "^8.24.0"
  }
}
