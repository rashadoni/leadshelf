# LeadShelf vision service (HTTP boundary /v1/scan).
PORT="4010"

# Провайдер распознавания полки: stub | openai | gemini.
# stub — честный no-inference (для CI/демо без ключей).
VISION_PROVIDER="stub"

# Публичный/сервисно-доступный базовый URL медиа, если photoUrl приходит
# относительным ключом (иначе нужен https:// или data: URL).
VISION_PUBLIC_BASE_URL=""

# --- openai ---
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"

# --- gemini (Google AI Studio: https://aistudio.google.com/app/apikey) ---
# Ключ — СЕКРЕТ, только в env сервиса, никогда в git и не в приложение.
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-2.5-flash"
# GEMINI_BASE_URL, GEMINI_VISION_TIMEOUT_MS, GEMINI_VISION_MIN_CONFIDENCE — опционально.

# --- NVIDIA LocateAnything-3B: ТОЛЬКО non-commercial evaluation ---
# Не является VISION_PROVIDER и не подключается к production /v1/scan.
LOCATEANYTHING_NONCOMMERCIAL_EVALUATION_ONLY="0"
LOCATEANYTHING_WORKER_URL="http://127.0.0.1:8091"
LOCATEANYTHING_WORKER_TOKEN=""
LOCATEANYTHING_MODEL="nvidia/LocateAnything-3B"
LOCATEANYTHING_QUERY="retail product package"
LOCATEANYTHING_GENERATION_MODE="hybrid"
LOCATEANYTHING_UNCALIBRATED_CONFIDENCE="0.5"
