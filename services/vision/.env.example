# LeadShelf vision service (HTTP boundary /v1/scan).
PORT="4010"

# Провайдер распознавания полки: stub | openai | gemini.
# stub — честный no-inference (для CI/демо без ключей).
VISION_PROVIDER="stub"

# Публичный/сервисно-доступный базовый URL медиа, если photoUrl приходит
# относительным ключом (иначе нужен https:// или data: URL).
VISION_PUBLIC_BASE_URL=""

# --- openai ---
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"

# --- gemini (Google AI Studio: https://aistudio.google.com/app/apikey) ---
# Ключ — СЕКРЕТ, только в env сервиса, никогда в git и не в приложение.
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-2.5-flash"
# GEMINI_BASE_URL, GEMINI_VISION_TIMEOUT_MS, GEMINI_VISION_MIN_CONFIDENCE — опционально.
