DATABASE_URL="postgresql://leadshelf:leadshelf@localhost:55432/leadshelf?schema=public"
S3_ENDPOINT="http://localhost:59000"
S3_ACCESS_KEY="leadshelf"
S3_SECRET_KEY="leadshelf"
S3_BUCKET="leadshelf-media"

# Selected-frame analysis provider: stub | openai | gemini.
# Without a key, proof-analysis extracts frames and records a stub/manual-review result.
# (LEADSHELF_PROOF_AI_PROVIDER overrides VISION_PROVIDER just for the worker.)
VISION_PROVIDER="stub"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
# Gemini (Google AI Studio: https://aistudio.google.com/app/apikey). Ключ — секрет.
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-2.5-flash"
# Sentry: серверный DSN (пусто = выключено). Краши воркера.
SENTRY_DSN=""
# Durable catalog import queue: exponential retry and abandoned lease recovery.
LEADSHELF_IMPORT_QUEUE_POLL_MS="5000"
LEADSHELF_IMPORT_QUEUE_MAX_ATTEMPTS="3"
LEADSHELF_IMPORT_QUEUE_RETRY_BASE_MS="5000"
LEADSHELF_IMPORT_QUEUE_RETRY_MAX_MS="300000"
LEADSHELF_IMPORT_QUEUE_STALE_MS="1800000"
# Destructive products full-sync is disabled by default. Enable only for the
# approved worker runtime after prepare -> issue -> attach and mount the same
# owner-only signing key file used by the issuer. Never put the key value here.
LEADSHELF_FULL_SYNC_ENABLED="false"
LEADSHELF_FULL_SYNC_APPROVAL_KEY_FILE=""
# Push delivery queue uses the same bounded retry/lease model.
LEADSHELF_NOTIFICATION_POLL_MS="5000"
LEADSHELF_NOTIFICATION_LIMIT_PER_ORG="100"
LEADSHELF_NOTIFICATION_MAX_ATTEMPTS="3"
LEADSHELF_NOTIFICATION_RETRY_MS="5000"
LEADSHELF_NOTIFICATION_RETRY_MAX_MS="300000"
LEADSHELF_NOTIFICATION_STALE_MS="900000"
LEADSHELF_PROOF_ANALYSIS_POLL_MS="5000"
LEADSHELF_PROOF_ANALYSIS_LIMIT_PER_TICK="3"
LEADSHELF_PROOF_ANALYSIS_MAX_ATTEMPTS="3"
LEADSHELF_PROOF_ANALYSIS_RETRY_MS="60000"
LEADSHELF_PROOF_ANALYSIS_STALE_MS="900000"
# Per-tenant PostgreSQL cost ceiling for external OpenAI/Gemini proof calls.
# Over-limit proof is persisted as SKIPPED and routed to human review before
# media bytes are read. Stub/local providers do not consume this budget.
LEADSHELF_PROOF_AI_MAX_PER_WINDOW="100"
LEADSHELF_PROOF_AI_WINDOW_MS="3600000"
LEADSHELF_PROOF_VIDEO_MAX_FRAMES="8"
