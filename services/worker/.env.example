# Without these, proof-analysis extracts frames and records a stub/manual-review result.
VISION_PROVIDER="stub"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
LEADSHELF_PROOF_ANALYSIS_POLL_MS="5000"
LEADSHELF_PROOF_ANALYSIS_LIMIT_PER_TICK="3"
LEADSHELF_PROOF_VIDEO_MAX_FRAMES="8"
